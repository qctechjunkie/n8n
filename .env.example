# n8n Configuration
# Copy this file to .env and update the values

# Basic Configuration
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost

# Security
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# Encryption key for credentials (generate with: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=

# Timezone
GENERIC_TIMEZONE=America/New_York
TZ=America/New_York

# Execution Mode
EXECUTIONS_MODE=regular

# Webhook URL (used for webhook nodes)
WEBHOOK_URL=http://localhost:5678/

# ---- PostgreSQL (Global Instance) -------------------------------------------

# Container name of the global-postgres instance on this host
DB_POSTGRESDB_HOST=lxc103-postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=changeme

# Docker network shared with global-postgres (must match NETWORK_NAME in global-postgres .env)
POSTGRES_NETWORK_NAME=lxc103-postgres-network

# Email Configuration (optional)
# N8N_EMAIL_MODE=smtp
# N8N_SMTP_HOST=smtp.gmail.com
# N8N_SMTP_PORT=465
# N8N_SMTP_USER=
# N8N_SMTP_PASS=
# N8N_SMTP_SENDER=

# Advanced Settings
N8N_METRICS=false
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console

# External Hooks (optional)
# EXTERNAL_HOOK_FILES=

# Custom nodes (optional)
# N8N_CUSTOM_EXTENSIONS=
